{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run contracts:build && npm run build --workspace=@gym-tracking/web",
  "framework": "vite",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm ci --include=dev --ignore-scripts",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://gym-progress-tracker-lj6n.onrender.com/api/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
