# ─── API Server ────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/gym_tracking

# ─── CORS ──────────────────────────────────────────────────
WEB_ORIGIN=http://localhost:5173

# ─── JWT Secrets (min 32 chars — generate: openssl rand -base64 32) ──
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Optional admin bootstrap (set both or leave both empty)
# If the email already exists, the account is promoted without changing its password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Token TTL (seconds) ──────────────────────────────────
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# ─── Token Claims ─────────────────────────────────────────
TOKEN_AUDIENCE=gym-tracking-web
TOKEN_ISSUER=gym-tracking-api

# ─── Web App ──────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api/v1
